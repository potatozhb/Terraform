# Append these settings to your existing .env; keep its project endpoint settings.
AZURE_SEARCH_ENDPOINT=https://ai-billing-search-69fe.search.windows.net
AZURE_SEARCH_INDEX_NAME=billing-knowledge-index
# Search admin key (a query key cannot upload documents).
AZURE_SEARCH_ADMIN_KEY=
# Use the account endpoint, not AZURE_AI_PROJECT_ENDPOINT.
AZURE_OPENAI_ENDPOINT=https://ai-billing-foundry-69fe.cognitiveservices.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small-code-vector
# Optional read-only Search key for building prompts (admin key is a fallback).
AZURE_SEARCH_QUERY_KEY=
# Blob credentials: use a connection string OR an account key with the account name.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_ACCOUNT_NAME=aibillingstorage69fe
AZURE_STORAGE_ACCOUNT_KEY=
AZURE_STORAGE_CONTAINER_NAME=foundry
# Optional single-order selection; leave empty to compare all JSON order blobs.
AZURE_STORAGE_BLOB_NAME=
# Optional folder prefix when comparing all orders (for example orders/).
AZURE_STORAGE_BLOB_PREFIX=
# Comma-separated Azure chat deployment names used by compare_model.py.
# All compared deployments must be available on the same chat endpoint.
AZURE_OPENAI_COMPARE_DEPLOYMENTS=ai-billing-foundry-6.1-sol,ai-billing-foundry-5.6-sol
# Optional chat account override; defaults to the embedding account endpoint/key.
AZURE_OPENAI_CHAT_ENDPOINT=
AZURE_OPENAI_CHAT_API_KEY=
AZURE_OPENAI_CHAT_API_VERSION=2024-10-21
